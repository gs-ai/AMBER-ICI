      "outputs": [
        "Canonical records"
      ],
      "algorithm": "Parsers + schema validation",
      "data_structures": [
        "CaseRecord"
      ],
      "error_handling": "Reject malformed records",
      "quality_checks": [
        "Required field completeness"
      ]
    },
    {
