{
  "spec_version": "1.0.0",
  "title": "Behavioral Profiling Operational Engine",
  "mode": "evidence-weighted, inference-constrained, explainable",
  "design_principles": [
    "Observation over assumption",
    "Probabilistic inference over certainty claims",
    "Versioned profile updates",
    "Explicit contradiction tracking",
    "Human-auditable output"
  ],
  "complexity": {
    "time": "O(n + n*v + n*r)",
    "space": "O(n + v + r + t)",
    "variables": {
      "n": "number of evidence/events",
      "v": "number of extracted variables",
      "r": "number of active rules",
      "t": "timeline nodes and links"
    }
  },
  "input_contract": {
    "required_inputs": [
      "case_id",
      "event_records",
      "scene_observations",
      "victimology_data",
      "timeline_hypotheses",
      "source_reliability"
    ],
    "optional_inputs": [
      "media_activity",
      "geographic_context",
      "institutional_constraints"
    ]
  },
  "output_contract": {
    "required_outputs": [
      "baseline_model",
      "deviation_signals",
      "intent_inference",
      "risk_scores",
      "confidence_scores",
      "explanation_bundle",
      "update_delta"
    ]
  },
  "book_level_intelligence_map": {
    "core_theories": [
      "Profiling is structured inference, not hard certainty",
      "Physical evidence can invalidate narrative assumptions",
      "Behavior has stable and adaptive components",
      "Profiles must be iterative and versioned"
    ],
    "behavioral_assumptions": [
      "Offenders adapt MO under pressure",
      "Signature-like behavior tends to be more stable",
      "Victim selection reflects opportunity + preference + constraint",
      "Media/police feedback loops can alter offender behavior"
    ],
    "evidence_types": [
      "scene_physical",
      "biological_temporal",
      "victimological",
      "geographic",
      "linguistic",
      "witness",
      "procedural"
    ],
    "hidden_states": [
      "control_need",
      "escalation_drive",
      "risk_tolerance",
      "tactical_adaptation",
      "narrative_manipulation_intent"
    ],
    "causal_structures": [
      {
        "cause": "investigative pressure increase",
        "effect": "offender pattern displacement"
      },
      {
        "cause": "media amplification",
        "effect": "attention-seeking behavior probability increase"
      },
      {
        "cause": "timeline contradiction",
        "effect": "profile confidence decrease"
      }
    ],
    "risk_factors": [
      "repeated escalation markers",
      "shrinking cooling-off interval",
      "broader victim class expansion",
      "deliberate distance displacement",
      "post-offense communication behavior"
    ],
    "predictive_signals": [
      "location drift with behavioral continuity",
      "tactical changes preserving core ritual",
      "inconsistent disposal timing",
      "targeted event-window offenses"
    ]
  },
  "concept_extraction_table": [
    {
      "concept_name": "Baseline Construction",
      "definition": "Stable behavior reference model",
      "observable_inputs": [
        "prior incidents",
        "victim traits",
        "method patterns"
      ],
      "hidden_variables": [
        "stability index"
      ],
      "inference_rules": [
        "If repeated markers persist across incidents, baseline confidence increases"
      ],
      "false_positives": [
        "copycat effects"
      ],
      "false_negatives": [
        "sparse case history"
      ],
      "operational_use": "Anchor for deviation scoring"
    },
    {
      "concept_name": "Pattern Deviation",
      "definition": "Distance from baseline",
      "observable_inputs": [
        "method shifts",
        "location shifts",
        "timing shifts"
      ],
      "hidden_variables": [
        "adaptation pressure"
      ],
      "inference_rules": [
        "If deviation exceeds threshold and contradictions are low, mark tactical shift"
      ],
      "false_positives": [
        "environmental disruption"
      ],
      "false_negatives": [
        "slow drift hidden in noise"
      ],
      "operational_use": "Early-warning indicator"
    },
    {
      "concept_name": "Intent Inference",
      "definition": "Probabilistic motive/goal estimate",
      "observable_inputs": [
        "targeting pattern",
        "interaction style",
        "post-offense behavior"
      ],
      "hidden_variables": [
        "control and symbolic needs"
      ],
      "inference_rules": [
        "Weighted rules over behavior clusters"
      ],
      "false_positives": [
        "misread symbolism"
      ],
      "false_negatives": [
        "overfitting to one event"
      ],
      "operational_use": "Prioritize interview strategy"
    }
  ],
  "behavioral_variable_model": {
    "variables": [
      {
        "name": "scene_control_index",
        "type": "float",
        "description": "Degree of offender control over scene and victim interaction",
        "format": "0.0-1.0",
        "extraction_method": "rule-based from scene markers",
        "weight_range": "0.05-0.20",
        "confidence_range": "0.30-0.95",
        "normalization": "min-max",
        "interactions": [
          "victim_selection_specificity",
          "post_offense_staging_score"
        ]
      },
      {
        "name": "victim_selection_specificity",
        "type": "float",
        "description": "How narrow and repeatable victim selection criteria are",
        "format": "0.0-1.0",
        "extraction_method": "cluster compactness over victim attributes",
        "weight_range": "0.05-0.18",
        "confidence_range": "0.40-0.95",
        "normalization": "z-score then logistic squash",
        "interactions": [
          "baseline_stability_score",
          "intent_class_probability"
        ]
      },
      {
        "name": "timeline_consistency_score",
        "type": "float",
        "description": "Agreement between biological, witness, and scene timing",
        "format": "0.0-1.0",
        "extraction_method": "constraint satisfaction over time windows",
        "weight_range": "0.08-0.25",
        "confidence_range": "0.50-0.98",
        "normalization": "constraint ratio",
        "interactions": [
          "confidence_global",
          "contradiction_index"
        ]
      },
      {
        "name": "geographic_displacement_ratio",
        "type": "float",
        "description": "Distance shift relative to historical comfort zone",
        "format": "0.0-3.0+",
        "extraction_method": "current centroid distance / baseline radius",
        "weight_range": "0.04-0.15",
        "confidence_range": "0.45-0.95",
        "normalization": "log1p",
        "interactions": [
          "adaptation_pressure_score",
          "escalation_potential"
        ]
      },
      {
        "name": "mo_variability_score",
        "type": "float",
        "description": "Operational-method variability across events",
        "format": "0.0-1.0",
        "extraction_method": "feature entropy",
        "weight_range": "0.03-0.14",
        "confidence_range": "0.30-0.90",
        "normalization": "entropy/entropy_max",
        "interactions": [
          "signature_stability_score",
          "deception_inconsistency_score"
        ]
      },
      {
        "name": "signature_stability_score",
        "type": "float",
        "description": "Persistence of nonfunctional behavioral motifs",
        "format": "0.0-1.0",
        "extraction_method": "motif recurrence with rarity weighting",
        "weight_range": "0.06-0.22",
        "confidence_range": "0.35-0.97",
        "normalization": "rarity-weighted recurrence",
        "interactions": [
          "linkage_probability",
          "intent_class_probability"
        ]
      },
      {
        "name": "media_reactivity_score",
        "type": "float",
        "description": "Behavior changes following media spikes",
        "format": "0.0-1.0",
        "extraction_method": "lagged correlation against media timeline",
        "weight_range": "0.02-0.10",
        "confidence_range": "0.20-0.85",
        "normalization": "pearson/spearman fused",
        "interactions": [
          "attention_seeking_likelihood",
          "pattern_deviation_score"
        ]
      },
      {
        "name": "contradiction_index",
        "type": "float",
        "description": "Aggregate contradiction load among evidence sources",
        "format": "0.0-1.0",
        "extraction_method": "weighted contradiction graph density",
        "weight_range": "0.10-0.30",
        "confidence_range": "0.60-0.99",
        "normalization": "weighted ratio",
        "interactions": [
          "confidence_global",
          "inference_suppression_factor"
        ]
      },
      {
        "name": "cooling_off_interval_trend",
        "type": "float",
        "description": "Trend slope of inter-event intervals",
        "format": "real",
        "extraction_method": "robust regression slope",
        "weight_range": "0.05-0.20",
        "confidence_range": "0.40-0.95",
        "normalization": "slope scaled by median interval",
        "interactions": [
          "escalation_potential",
          "risk_score_behavioral"
        ]
      },
      {
        "name": "stress_pressure_indicator",
        "type": "float",
        "description": "Estimated external/internal pressure load",
        "format": "0.0-1.0",
        "extraction_method": "composite from tactical errors and drift",
        "weight_range": "0.04-0.16",
        "confidence_range": "0.35-0.90",
        "normalization": "weighted composite",
        "interactions": [
          "mo_variability_score",
          "geographic_displacement_ratio"
        ]
      }
    ]
  },
  "algorithmic_modules": [
    {
      "name": "BaselineModelBuilder",
      "purpose": "Construct stable reference behavior",
      "inputs": [
        "events",
        "victimology",
        "scene_features"
      ],
      "outputs": [
        "baseline_model",
        "baseline_confidence"
      ],
      "feature_extraction_steps": [
        "normalize feature namespaces",
        "compute recurrence vectors",
        "compute rarity-weighted motifs",
        "fit robust centroid and dispersion"
      ],
      "decision_logic": "retain features with recurrence >= threshold and confidence >= min_conf",
      "scoring_method": "stability = recurrence * rarity_weight * source_reliability",
      "confidence_calculation": "bootstrap consistency across event subsets",
      "edge_cases": [
        "single-event case",
        "mixed-offender contamination"
      ],
      "failure_modes": [
        "false baseline from early sparse data"
      ],
      "recommended_data_structures": [
        "FeatureVector",
        "MotifIndex",
        "ConfidenceEnvelope"
      ]
    },
    {
      "name": "DeviationDetector",
      "purpose": "Detect departures from baseline",
      "inputs": [
        "new_event",
        "baseline_model"
      ],
      "outputs": [
        "deviation_signals",
        "deviation_score"
      ],
      "decision_logic": "weighted distance + rule exceptions",
      "scoring_method": "Mahalanobis-like distance with categorical penalties",
      "confidence_calculation": "depends on baseline size and feature completeness"
    },
    {
      "name": "IntentInferenceEngine",
      "purpose": "Produce probability over intent classes",
      "inputs": [
        "signature_features",
        "victimology_features",
        "context_features"
      ],
      "outputs": [
        "intent_probabilities",
        "supporting_evidence"
      ],
      "decision_logic": "rule-ensemble + calibrated probabilistic layer",
      "scoring_method": "softmax over weighted intent logits",
      "confidence_calculation": "entropy-based certainty + contradiction penalty"
    }
  ],
